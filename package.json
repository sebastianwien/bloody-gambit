{
  "name": "bloody-gambit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:online": "tsc --noEmit && vite build --base=./ --outDir dist-online --emptyOutDir",
    "preview": "vite preview --port 5180 --strictPort",
    "server": "node server/src/index.ts",
    "start:all": "node tools/start-all.mjs",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "opentype.js": "^2.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
